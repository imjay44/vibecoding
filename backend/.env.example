APP_ENV=development
APP_NAME=HomeServe Technologies API
SECRET_KEY=your-super-secret-key-replace-in-production
JWT_SECRET_KEY=your-jwt-secret-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Connection (Production/Staging):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/homeserve_db
# SQLite fallback for local development or automated tests:
DATABASE_URL=sqlite:///./homeserve.db

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_placeholder

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=cloudinary_placeholder
CLOUDINARY_API_KEY=cloudinary_key_placeholder
CLOUDINARY_API_SECRET=cloudinary_secret_placeholder

# Optional SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@homeserve.local

# RAG Chatbot with LangChain and Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
RAG_PDF_PATH=ragbased.pdf
